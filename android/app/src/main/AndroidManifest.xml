<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.mdz.skyscan" android:versionCode="10" android:versionName="1.0.10">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="MDZ SkyScan" android:theme="@android:style/Theme.Material.NoActionBar"
        android:icon="@drawable/ic_launcher" android:allowBackup="false" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
